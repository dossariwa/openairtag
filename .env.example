# Use a DEVELOPMENT deployment. The CLI uploads to this target.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk dashboard authentication and Convex JWT issuer
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Origin-restricted public Mapbox token
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
